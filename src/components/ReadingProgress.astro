---
/** Barra de progreso de lectura, fija en el borde superior. */
---

<div
  id="reading-progress"
  class="bg-base-300 fixed inset-x-0 top-0 z-50 h-[3px]"
  role="progressbar"
  aria-label="Progreso de lectura"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <div class="bg-primary h-full w-0" data-bar></div>
</div>

<script>
  function update() {
    const root = document.getElementById('reading-progress');
    const bar = root?.querySelector<HTMLElement>('[data-bar]');
    if (!root || !bar) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
    bar.style.width = `${pct}%`;
    root.setAttribute('aria-valuenow', String(Math.round(pct)));
  }

  // Los oyentes se registran una sola vez; la barra se busca en cada llamada
  // porque el router de transiciones reemplaza el <body>.
  const w = window as Window & { __zillaProgress?: boolean };
  if (!w.__zillaProgress) {
    w.__zillaProgress = true;
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    document.addEventListener('astro:page-load', update);
  }
  update();
</script>
