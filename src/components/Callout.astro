---
/**
 * Reusable callout for MDX content. Use as:
 *   <Callout type="info" title="Heads up">…</Callout>
 */
import { Icon } from 'astro-icon/components';

interface Props {
  type?: 'info' | 'success' | 'warning' | 'error';
  title?: string;
}

const icons = {
  info: 'lucide:info',
  success: 'lucide:circle-check',
  warning: 'lucide:triangle-alert',
  error: 'lucide:circle-x',
} as const;

const { type = 'info', title } = Astro.props;
---

<aside class:list={['callout', `callout-${type}`]} role="note">
  {
    title ? (
      <p class="callout-title font-display mt-0! mb-2 flex items-center gap-2.5 text-base font-bold">
        <Icon name={icons[type]} width={20} height={20} class="shrink-0" aria-hidden="true" />
        <span>{title}</span>
      </p>
    ) : null
  }
  <div class:list={[!title && 'flex items-start gap-3']}>
    {
      !title && (
        <Icon
          name={icons[type]}
          width={20}
          height={20}
          class="callout-title mt-1 shrink-0"
          aria-hidden="true"
        />
      )
    }
    <div class="min-w-0" data-callout-body><slot /></div>
  </div>
</aside>
