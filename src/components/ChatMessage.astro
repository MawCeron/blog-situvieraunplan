---
import { Image } from 'astro:assets';
import { SITE } from '../config';

type Tone = 'neutral' | 'primary' | 'accent' | 'info' | 'success' | 'warning' | 'error';

interface Props {
  /** Nombre de quien habla. */
  from: string;
  /** Mensaje tuyo: tu avatar, a la derecha y con el color primario (salvo que pases `side` o `tone`). */
  me?: boolean;
  /** Lado de la burbuja. Por defecto, a la derecha si es `me` y a la izquierda si no. */
  side?: 'start' | 'end';
  /** Color de la burbuja, para distinguir a varios interlocutores. */
  tone?: Tone;
}

// Clases literales: Tailwind no ve las que se arman con plantillas.
const toneClass: Record<Tone, string> = {
  neutral: '',
  primary: 'chat-bubble-primary',
  accent: 'chat-bubble-accent',
  info: 'chat-bubble-info',
  success: 'chat-bubble-success',
  warning: 'chat-bubble-warning',
  error: 'chat-bubble-error',
};

const { from, me = false, side = me ? 'end' : 'start', tone = me ? 'primary' : 'neutral' } =
  Astro.props;
const avatar = SITE.author.avatar;
const initial = from.trim().charAt(0).toUpperCase();
---

<div class:list={['chat', side === 'end' ? 'chat-end' : 'chat-start']}>
  <div
    class="chat-image avatar"
    class:list={[!(me && avatar) && 'avatar-placeholder']}
    aria-hidden="true"
  >
    <div class="bg-base-300 text-muted font-display w-9 rounded-full text-sm font-bold">
      {
        me && avatar && typeof avatar !== 'string' ? (
          <Image
            src={avatar}
            alt=""
            width={72}
            height={72}
            class="block size-9 object-cover"
            loading="eager"
          />
        ) : (
          initial
        )
      }
    </div>
  </div>
  <div class="chat-header text-muted mb-1 text-xs font-semibold">{from}</div>
  <div class:list={['chat-bubble', toneClass[tone]]}><slot /></div>
</div>
