---
import type { Locale } from '../config';
import { useTranslations } from '../i18n/utils';
import { type Post, postPath } from '../utils/posts';

interface Props {
  prev?: Post;
  next?: Post;
  locale: Locale;
}

const { prev, next, locale } = Astro.props;
const t = useTranslations(locale);
const card =
  'border-base-300 bg-base-100 hover:border-primary min-w-0 flex-[1_1_260px] rounded-2xl border px-[22px] py-5 transition-colors';
const label = 'text-muted mb-1.5 text-xs font-semibold tracking-[0.12em] uppercase';
const title = 'font-display text-lg leading-tight font-bold';
---

<nav aria-label="Post navigation" class="mt-10 flex flex-wrap gap-4">
  {
    prev && (
      <a href={postPath(prev)} rel="prev" class={card}>
        <div class={label}>{`← ${t('post.previous')}`}</div>
        <div class={title}>{prev.data.title}</div>
      </a>
    )
  }
  {
    next && (
      <a href={postPath(next)} rel="next" class:list={[card, 'text-right']}>
        <div class={label}>{`${t('post.next')} →`}</div>
        <div class={title}>{next.data.title}</div>
      </a>
    )
  }
</nav>
