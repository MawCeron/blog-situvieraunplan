---
/**
 * Reproductor de un episodio de podcast con el `<audio>` nativo y enlaces para
 * descargarlo o escucharlo en otras plataformas. Solo para MDX:
 *
 *   <PodcastPlayer
 *     src="https://mx.ivoox.com/es/episodio-7_md_10870924_wp_1.mp3"
 *     title="Episodio 7. Del tren del mame a los lentes para pollo"
 *     links={[{ label: 'iVoox', href: 'https://www.ivoox.com/…' }]}
 *   />
 *
 * Agrega «Descargar» con la misma `src`; pasa `download={false}` para quitarlo.
 * El audio no se baja hasta que se pulsa reproducir (`preload="none"`).
 */

interface Props {
  /** URL del archivo de audio. */
  src: string;
  /** Título del episodio. */
  title: string;
  /** Enlaces extra, como «iVoox» o «iTunes». */
  links?: Array<{ label: string; href: string }>;
  /** Muestra el enlace «Descargar». */
  download?: boolean;
}

const { src, title, links = [], download = true } = Astro.props;
const all = [...(download ? [{ label: 'Descargar', href: src }] : []), ...links];
---

<aside class="podcast-player border-base-300 bg-surface2 my-6 rounded-2xl border px-6 py-5">
  <p class="text-muted mt-0 mb-1 text-xs font-bold tracking-[0.16em] uppercase">Podcast</p>
  <p class="font-display mt-0 mb-3 text-base font-bold">{title}</p>
  <audio class="block w-full" controls preload="none" src={src} aria-label={title}>
    Tu navegador no reproduce audio. <a href={src}>Descarga el episodio</a>.
  </audio>
  {
    all.length > 0 && (
      <p class="mt-3 mb-0 flex flex-wrap gap-x-5 gap-y-1 text-sm">
        {all.map((link) => (
          <a href={link.href} rel="noopener">
            {link.label}
          </a>
        ))}
      </p>
    )
  }
</aside>
