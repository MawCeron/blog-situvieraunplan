---
import BaseLayout from './BaseLayout.astro';
import PostNav from '../components/PostNav.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/islands/TableOfContents.astro';
import SmartImage from '../components/SmartImage.astro';
import Giscus from '../components/islands/Giscus.astro';
import { GISCUS, SITE, type Locale } from '../config';
import { useTranslations, stripLocale, formatDate, isoDate, localizedPath } from '../i18n/utils';
import { readingTime } from '../utils/reading-time';
import {
  type Post,
  tagPath,
  categoryPath,
  postSlug,
  heroImage,
  heroImageSrc,
  shouldShowHero,
} from '../utils/posts';
import { buildSeo } from '../utils/seo';
import type { MarkdownHeading } from 'astro';

interface Props {
  post: Post;
  /** Astro's `headings` array from `await render(post)`. */
  headings: MarkdownHeading[];
  /** Raw body string used for reading time. */
  body: string;
  prev?: Post;
  next?: Post;
  locale: Locale;
}

const { post, headings, body, prev, next, locale } = Astro.props;
const t = useTranslations(locale);
const minutes = readingTime(body).minutes;

const commentsEnabled = post.data.comments !== false && GISCUS.enabled;
const pathWithoutLocale = stripLocale(Astro.url.pathname);

const heroSrc = heroImageSrc(post);
const heroAsset = heroImage(post);
const showHero = shouldShowHero(post) && (post.data.showHeroInPost ?? SITE.showHeroInPosts);
const heroAlt = post.data.heroImageAlt ?? '';

const hasToc = post.data.toc && headings.length > 0;

// «Título principal (aclaración)»: la aclaración final entre paréntesis va atenuada.
const titleParts = post.data.title.match(/^(.*?)\s+(\(.+\))$/);
const titleMain = titleParts ? titleParts[1] : post.data.title;
const titleTail = titleParts ? titleParts[2] : '';
const chip =
  'border-base-300 text-muted hover:border-primary hover:text-primary rounded-full border px-3 py-0.5 transition-colors';

// Use hero image for OG if available, otherwise fallback to the generated OG image
// (unless Auto-OG is disabled globally or skipped in CI).
const ogSlug = postSlug(post);
const ogPrefix = locale === SITE.defaultLocale ? '' : `${locale}/`;
const generatedOgPath = `/og/${ogPrefix}${ogSlug}.png`;
const skipAutoOg = !SITE.autoOgImage || import.meta.env.CI_SKIP_AUTO_OG_IMAGE === 'true';
const ogImage = heroSrc ?? (skipAutoOg ? undefined : generatedOgPath);

const seo = buildSeo({
  title: post.data.title,
  description: post.data.description,
  pathWithoutLocale,
  fullPath: Astro.url.pathname,
  locale,
  ogImage,
  type: 'article',
  publishedTime: post.data.pubDate,
  modifiedTime: post.data.updatedDate,
  tags: post.data.tags,
  // An unlisted post hides from SEO by default unless the author
  // explicitly sets `unlistedHideFromSeo: false`.
  noindex: post.data.unlisted && (post.data.unlistedHideFromSeo ?? true),
});

const crumbs = [
  { label: t('nav.posts'), href: localizedPath('/', locale) },
  { label: post.data.title },
];

let MathStylesComponent;
if (post.data.math) {
  MathStylesComponent = (await import('../components/MathStyles.astro')).default;
}

let MermaidComponent;
if (post.data.mermaid) {
  MermaidComponent = (await import('../components/islands/Mermaid.astro')).default;
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  tags={post.data.tags}
  crumbs={crumbs}
  seo={seo}
  wide
>
  {post.data.math && MathStylesComponent && <MathStylesComponent />}
  {post.data.mermaid && MermaidComponent && <MermaidComponent />}
  <ReadingProgress />

  <nav aria-label="Ruta" class="text-muted mb-5 text-[13px]">
    <a href={localizedPath('/', locale)} class="hover:text-primary">{t('nav.home')}</a>
    <span aria-hidden="true" class="mx-1.5">/</span>
    <a href={localizedPath('/archives', locale)} class="hover:text-primary">{t('nav.posts')}</a>
  </nav>

  <header class="max-w-[900px]">
    <h1
      class="font-display mb-[18px] text-5xl leading-[1.05] font-extrabold tracking-[-0.028em] max-sm:text-[2rem]"
    >
      {titleMain}
      {titleTail && <span class="text-muted font-semibold">{` ${titleTail}`}</span>}
    </h1>
    <p class="text-muted mb-5 max-w-[66ch] text-xl leading-snug">{post.data.description}</p>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2.5 text-sm">
      <time datetime={isoDate(post.data.pubDate)} class="text-warm font-semibold">
        {formatDate(post.data.pubDate, locale, { day: 'numeric', month: 'short', year: 'numeric' })}
      </time>
      {
        post.data.categories.map((c) => (
          <a href={categoryPath(locale, c)} class={chip}>
            {c}
          </a>
        ))
      }
      <span class="text-muted">{`· ${minutes} ${t('post.readingTime')}`}</span>
      {
        post.data.updatedDate && (
          <time datetime={isoDate(post.data.updatedDate)} class="text-muted">
            {`· ${t('post.updatedOn')} ${formatDate(post.data.updatedDate, locale)}`}
          </time>
        )
      }
    </div>
  </header>

  {
    showHero && heroAsset && (
      <figure class="mt-9">
        <div class="border-base-300 h-[460px] overflow-hidden rounded-[20px] border max-sm:h-[240px] [&_img]:h-full!">
          <SmartImage
            src={heroAsset}
            alt={heroAlt}
            class="size-full object-cover"
            loading="eager"
            fetchpriority="high"
            widths={[480, 768, 1024, 1280, 1600]}
            sizes="(max-width: 1120px) 100vw, 1120px"
            quality={82}
          />
        </div>
      </figure>
    )
  }

  <div class="mt-14 flex flex-wrap justify-center gap-x-[72px] gap-y-12">
    <article class="max-w-[700px] min-w-0 flex-[1_1_560px]">
      {
        hasToc && (
          <details class="zilla-toc-mobile mb-8 min-[1000px]:hidden">
            <summary class="zilla-menu__summary">{t('post.toc')}</summary>
            <ol class="mt-2 space-y-1.5 px-1 text-sm">
              {headings
                .filter((h) => h.depth >= 2 && h.depth <= 3)
                .map((h) => (
                  <li class={h.depth === 3 ? 'pl-4' : ''}>
                    <a href={`#${h.slug}`} class="hover:text-primary">
                      {h.text}
                    </a>
                  </li>
                ))}
            </ol>
          </details>
        )
      }

      <div class="prose-zilla max-w-none">
        <slot />
      </div>

      {
        post.data.tags.length > 0 && (
          <footer class="border-base-300 mt-12 flex flex-wrap items-center gap-2.5 border-t pt-7">
            <span class="font-display text-muted mr-1.5 text-[13px] font-bold tracking-[0.16em] uppercase">
              {t('post.tags')}
            </span>
            {post.data.tags.map((tag) => (
              <a href={tagPath(locale, tag)} class="zilla-chip bg-base-100 flex h-9 items-center">
                {tag}
              </a>
            ))}
          </footer>
        )
      }

      <PostNav prev={prev} next={next} locale={locale} />

      {
        commentsEnabled ? (
          <Giscus locale={locale} />
        ) : (
          post.data.comments === false && (
            <p class="text-muted mt-10 text-sm">{t('post.commentsDisabled')}</p>
          )
        )
      }
    </article>

    {
      hasToc && (
        <aside
          aria-label={t('post.toc')}
          class="sticky top-6 hidden flex-[0_0_232px] self-start min-[1000px]:block"
        >
          <TableOfContents headings={headings} locale={locale} />
        </aside>
      )
    }
  </div>
</BaseLayout>
