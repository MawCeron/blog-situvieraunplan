---
import '../styles/global.css';

import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import BackToTop from '../components/islands/BackToTop.astro';
import { ClientRouter } from 'astro:transitions';
import faviconImg from '../assets/images/site/favicon.svg';
import { SITE, UMAMI, type Locale } from '../config';
import { detectLocale, htmlLang, useTranslations, stripLocale, withBase } from '../i18n/utils';
import { buildSeo, type SeoMeta } from '../utils/seo';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Logical path WITHOUT locale prefix (used for hreflang). */
  pathWithoutLocale?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Constrain main content width (used by Pages like About/404). */
  narrow?: boolean;
  /** Ensancha el contenido (entradas con tabla de contenidos lateral). */
  wide?: boolean;
  /** Pie completo (con últimas entradas y etiquetas): solo el listado de inicio. */
  fullFooter?: boolean;
  /** Sin efecto en Zilla; se conserva para no tocar cada página. */
  crumbs?: Array<{ label: string; href?: string }>;
  /** Pre-built SEO meta override. */
  seo?: SeoMeta;
  /** Locales con traducción de la página actual; acota los hreflang. */
  availableLocales?: readonly Locale[];
}

const {
  title,
  description,
  ogImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  narrow = false,
  wide = false,
  fullFooter = false,
  seo,
  availableLocales,
} = Astro.props;

const locale: Locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);
const lang = htmlLang(locale);

const pathWithoutLocale = Astro.props.pathWithoutLocale ?? stripLocale(Astro.url.pathname);
const meta: SeoMeta =
  seo ??
  buildSeo({
    title,
    description,
    pathWithoutLocale,
    fullPath: Astro.url.pathname,
    locale,
    ogImage,
    type,
    publishedTime,
    modifiedTime,
    tags,
    availableLocales,
  });
---

<!doctype html>
<html lang={lang} data-theme="zilla-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f7f2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d1412" />
    <link rel="icon" type="image/svg+xml" href={withBase(faviconImg.src)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} — RSS`}
      href={withBase('/rss.xml')}
    />
    <SEO meta={meta} />
    {/* Custom fonts configured via Astro Fonts API */}
    <Font cssVariable="--font-figtree" preload />
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <ClientRouter />
    {
      import.meta.env.PROD && UMAMI.websiteId && (
        <script is:inline defer src={UMAMI.src} data-website-id={UMAMI.websiteId} />
      )
    }
    {/* Apply persisted theme as early as possible to avoid FOUC. */}
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var stored = localStorage.getItem('theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var valid = stored === 'zilla-dark' || stored === 'zilla-light';
            var theme = valid ? stored : prefersDark ? 'zilla-dark' : 'zilla-light';
            if (!valid && stored) localStorage.setItem('theme', theme);
            document.documentElement.setAttribute('data-theme', theme);
          } catch {
            /* ignore */
          }
        }
        applyTheme();
        // Re-apply after view transitions swap in a fresh <html data-theme>.
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="focus:bg-primary focus:text-primary-content sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:px-3 focus:py-2"
    >
      {t('site.skipToContent')}
    </a>

    <div class="zilla-watermark" aria-hidden="true"></div>

    <div class="relative flex min-h-screen flex-col items-center">
      <Header locale={locale} />
      <main
        id="main"
        aria-label="Main Content"
        class:list={[
          'w-full flex-1 px-6 py-12',
          narrow ? 'max-w-[780px]' : wide ? 'max-w-[1120px]' : 'max-w-[920px]',
        ]}
      >
        <slot />
      </main>
      <Footer locale={locale} compact={!fullFooter} />
    </div>

    <BackToTop />
  </body>
</html>
