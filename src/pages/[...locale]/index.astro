---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FeaturedPost from '~/components/FeaturedPost.astro';
import PostList from '~/components/PostList.astro';
import Pagination from '~/components/Pagination.astro';
import { SITE } from '~/config';
import { localizedPath, useTranslations } from '~/i18n/utils';
import { getPosts } from '~/utils/posts';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = await getPosts(locale);
const pageSize = SITE.postsPerPage;
const lastPage = Math.max(1, Math.ceil(posts.length / pageSize));
const currentPage = 1;
const pagePosts = posts.slice(0, pageSize);

const hrefForPage = (n: number) => localizedPath(n === 1 ? '/' : `/page/${n}/`, locale);
---

<BaseLayout title={SITE.title} description={SITE.description} pathWithoutLocale="/" fullFooter>
  {pagePosts[0] && <FeaturedPost post={pagePosts[0]} locale={locale} />}

  <div class="mt-16 mb-1 flex items-center gap-4">
    <h2 class="font-display text-muted text-[13px] font-bold tracking-[0.16em] uppercase">
      {t('home.recent')}
    </h2>
    <div class="bg-base-300 h-px flex-1"></div>
    <a href={localizedPath('/archives', locale)} class="hover:text-primary text-sm font-semibold">
      {t('home.viewArchive')} →
    </a>
  </div>
  <PostList posts={pagePosts.slice(1)} locale={locale} />
  <Pagination
    currentPage={currentPage}
    lastPage={lastPage}
    hrefForPage={hrefForPage}
    locale={locale}
  />
</BaseLayout>
