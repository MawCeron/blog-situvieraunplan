{
  "name": "zilla",
  "version": "1.2.0",
  "type": "module",
  "description": "Zilla: tema de blog para Astro v7 con Tailwind v4, daisyUI, MDX, Pagefind y Giscus. Derivado de Chirping Astro.",
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && bun run pagefind",
    "preview": "astro preview",
    "serve": "bun run build && bun preview",
    "astro": "astro",
    "pagefind": "pagefind --site dist --output-subdir _pagefind",
    "postbuild": "echo \"Pagefind index generated in dist/_pagefind\"",
    "typecheck": "astro check",
    "test": "bun test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,md,mdx,css,json}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,jsx,md,mdx,css,json}\""
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.5",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@nullpinter/satteri-katex": "^0.1.2",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.0",
    "astro-icon": "^1.1.5",
    "mermaid": "^11.16.0",
    "satteri-external-links": "^0.1.0"
  },
  "overrides": {
    "@jridgewell/sourcemap-codec": "^1.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@iconify-json/lucide": "^1.2.115",
    "@iconify-json/simple-icons": "^1.2.88",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "daisyui": "^5.6.10",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^3.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "katex": "^0.18.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "satori": "^0.29.0",
    "shiki": "^4.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "zilla",
    "tailwindcss",
    "daisyui",
    "mdx",
    "pagefind",
    "giscus",
    "i18n",
    "blog"
  ]
}
